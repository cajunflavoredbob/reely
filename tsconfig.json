// CommonJS on purpose: the server runs as plain Node (`node dist/cmd/reely/main.js`),
// no bundler and no `"type": "module"`. Switch when a dependency we use goes
// ESM-only and breaks the CJS interop bridge: set `module` to `NodeNext`, add
// `"type": "module"` to package.json, and rewrite the remaining `require()`
// calls (Dockerfile HEALTHCHECK).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    // dist/ is COPY-ed into the runtime stage and published to Docker Hub, so
    // without this every comment in server source ships inside the image.
    "removeComments": true,
    // Match web/app's strictness floor: dead vars and params fail typecheck
    // without having to run the linter.
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["cmd/**/*", "internal/**/*", "types/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "web"
  ]
}
