{
  "name": "reely",
  "version": "1.1.8",
  "description": "Find a movie to watch together",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch cmd/reely/main.ts",
    "build:server": "tsc",
    "build:ui": "pnpm --filter reely-ui build",
    "build": "pnpm run build:server && pnpm run build:ui",
    "serve": "pnpm run build && NODE_ENV=production node --env-file=.env dist/cmd/reely/main.js",
    "typecheck:server": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:ui": "pnpm --filter reely-ui typecheck",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:tests && pnpm run typecheck:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:brand": "node scripts/gen-brand.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.1",
    "minimist": "^1.2.8",
    "pino": "^10.3.1",
    "ws": "^8.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "brace-expansion": ">=5.0.6",
      "picomatch": ">=4.0.4"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/accepts": "^1.3.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "zustand": "^5.0.14"
  }
}
