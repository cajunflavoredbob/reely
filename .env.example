# Example .env for local development (loaded by `pnpm serve`).
# Copy to .env and fill in your values. Only PLEX_URL + PLEX_TOKEN are
# required; everything else is optional and shown with its default.
# See README.markdown for the full configuration reference.

# --- Required: Plex server ---
PLEX_URL=http://192.168.1.x:32400
PLEX_TOKEN=your_plex_token_here

# --- Optional: library filtering ---
# Comma-separated movie-library names to include. Omit to use every movie
# library on the server. (reely is movies-only by design; show / music /
# photo libraries are always excluded.)
# LIBRARY_TITLE_FILTER=Movies,Kids Movies

# --- Optional: HTTP server ---
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
# ROOT_PATH=/reely            # sub-path prefix when behind a reverse proxy

# --- Optional: HTTP Basic Auth (set both to enable) ---
# AUTH_USER=admin
# AUTH_PASS=changeme

# --- Optional: TLS (set both to serve https) ---
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem

# --- Optional: WebSocket Origin allowlist ---
# Comma-separated extra origins to accept beyond same-origin; needed when a
# reverse proxy serves Reely under an origin that differs from its Host.
# ALLOWED_ORIGINS=https://reely.example.com

# --- Optional: Plex base URL exposure (audits 10 #165 / 12 #226, opt-out
#     added 0.4.15) ---
# Whether the WS `config` frame ships the Plex server's base URL to the
# browser. Default `true` so the frontend can build direct-LAN "Open in
# Plex" links when the LAN is reachable. Set `false` to withhold; all
# "Open in Plex" links then route through app.plex.tv. Useful when reely
# is WAN-exposed without basicAuth and you don't want the internal Plex
# address visible to anyone with WS access. Accepts true/false, 1/0,
# yes/no, on/off (case-insensitive).
# EXPOSE_PLEX_BASE_URL=true

# --- Optional: alternate config.yaml location ---
# CONFIG_PATH=/path/to/config.yaml
